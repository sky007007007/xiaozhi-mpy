obj_table: [0, 'Type file contents line by line, finish with EOF (Ctrl+D).', "rm of '%s' failed", '    <dir> %s', '          %s', '\n{:,d}k free', '\nupysh is intended to be imported using:\nfrom upysh import *\n\nTo see this help text again, type "man".\n\nupysh commands:\nclear, ls, ls(...), head(...), cat(...), newfile(...)\ncp(\'src\', \'dest\'), mv(\'old\', \'new\'), rm(...)\npwd, cd(...), mkdir(...), rmdir(...)\n']
